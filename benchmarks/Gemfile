# frozen_string_literal: true

source "https://rubygems.org"

boto_root = ENV.fetch("BOTO_ROOT", File.expand_path("..", __dir__))
gem "boto-rb", path: File.join(boto_root, "gems/boto-rb")
# Bases antigas (ex. CI) podem não ter o boto-rb-security: só declara a gem se a pasta existir.
boto_security_path = File.join(boto_root, "gems/boto-rb-security")
gem "boto-rb-security", path: boto_security_path if File.directory?(boto_security_path)
# Mesma regra: só o cenário db_auth_redis usa a boto-rb-redis, e ele é pulado sem ela.
boto_redis_path = File.join(boto_root, "gems/boto-rb-redis")
gem "boto-rb-redis", path: boto_redis_path if File.directory?(boto_redis_path)
gem "roda"
gem "sinatra"
gem "sequel"
gem "sqlite3"
gem "falcon"

group :test do
  gem "minitest", "~> 6.0"
end
