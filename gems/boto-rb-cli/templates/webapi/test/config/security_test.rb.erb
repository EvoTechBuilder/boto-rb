# frozen_string_literal: true

require "test_helper"

class <%= namespace %>SecurityTest < Minitest::Test
  def test_health_probes_ignore_wrong_token
    %w[/health/live /health/ready].each do |path|
      response = Rack::MockRequest.new(APP).get(path, "HTTP_AUTHORIZATION" => "Bearer wrong")
      assert_equal 200, response.status, path
    end
  end
end
